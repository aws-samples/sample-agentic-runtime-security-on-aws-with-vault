{
  "replacementPatterns": [
    {
      "pattern": "^/static/images/",
      "replacement": "../assets/"
    },
    {
      "pattern": "^/static",
      "replacement": "{{BASEURL}}/static"
    },
    {
      "pattern": "^/.*/$",
      "replacement": "{{BASEURL}}/content/index.en.md"
    },
    {
      "pattern": "^/",
      "replacement": "{{BASEURL}}/content/"
    }
  ],
  "ignorePatterns": [
    {
      "pattern": "localhost"
    },
    {
      "pattern": "developer.hashicorp.com"
    }
  ]
}
