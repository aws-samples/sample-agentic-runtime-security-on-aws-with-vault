#!/usr/bin/env bash
#===============================================================================
# 05-deploy-tier1/check-shell
# Asserts the tier-1 artifacts came up:
#   - EKS cluster ACTIVE
#   - kubectl context resolves and >= 2 Ready nodes
#   - ECR repositories present with at least one image tag each
#   - aws-load-balancer-controller deployment Available
#===============================================================================

set -euo pipefail

REPO="/root/workshop"
INFRA="${REPO}/infrastructure"

CLUSTER=$(grep -E '^[[:space:]]*cluster_name[[:space:]]*=' "${INFRA}/terraform.tfvars" \
    | head -1 | sed -E 's/.*"([^"]+)".*/\1/')
[ -n "${CLUSTER}" ] || { echo "FAIL: cluster_name missing from infrastructure/terraform.tfvars"; exit 1; }

STATE=$(aws eks describe-cluster --name "${CLUSTER}" --query cluster.status --output text 2>/dev/null) \
    || { echo "FAIL: aws eks describe-cluster ${CLUSTER} failed"; exit 1; }
[ "${STATE}" = "ACTIVE" ] || { echo "FAIL: EKS cluster ${CLUSTER} not ACTIVE (got: ${STATE})"; exit 1; }
echo "PASS: EKS cluster ${CLUSTER} ACTIVE"

# kubectl context should resolve from setup-shell (deploy-workshop.sh Step 2).
kubectl --context "${CLUSTER}" get nodes --no-headers > /tmp/.nodes 2>/dev/null \
    || { echo "FAIL: kubectl --context ${CLUSTER} get nodes failed"; exit 1; }
READY=$(awk '$2 == "Ready" {n++} END{print n+0}' /tmp/.nodes)
[ "${READY}" -ge 2 ] || { echo "FAIL: only ${READY} Ready nodes (need >= 2)"; exit 1; }
echo "PASS: ${READY} Ready nodes on ${CLUSTER}"

# ECR repos present (uc1-agent, uc2-agent, uc3-agent, banking-app, banking-ui at minimum)
REPOS=$(aws ecr describe-repositories --query 'repositories[].repositoryName' --output text 2>/dev/null \
    || true)
echo "    ECR repos: ${REPOS}"
for r in uc1-agent uc2-agent uc3-agent banking-app banking-ui; do
    grep -qw "${r}" <<<"${REPOS}" \
        || { echo "FAIL: ECR repository ${r} missing"; exit 1; }
done
echo "PASS: all 5 ECR repositories present"

# LBC available
kubectl --context "${CLUSTER}" -n kube-system rollout status deploy/aws-load-balancer-controller --timeout=60s \
    || { echo "FAIL: aws-load-balancer-controller not Available"; exit 1; }
echo "PASS: aws-load-balancer-controller Available"

echo "05-deploy-tier1: all checks green"
