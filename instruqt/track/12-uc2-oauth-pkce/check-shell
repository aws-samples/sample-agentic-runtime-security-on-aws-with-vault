#!/usr/bin/env bash
#===============================================================================
# 12-uc2-oauth-pkce/check-shell
# Asserts:
#   - IVIA OIDC discovery endpoint serves (issuer + authorization + token URLs)
#   - banking-ui has a public ALB endpoint reachable via the Ingress
#   - Vault's jwt/role/uc2-jwt is bound to bound_audiences=["agent-uc2"]
#
# A FULL PKCE login round-trip requires a real browser + IBM Verify session
# cookie; that is left to the manual Banking UI tab (which Instruqt opens
# automatically). The cluster-side assertions here prove the trust chain is
# present, which is sufficient to advance.
#===============================================================================

set -euo pipefail

REPO="/root/workshop"
CLUSTER=$(grep -E '^[[:space:]]*cluster_name[[:space:]]*=' "${REPO}/infrastructure/terraform.tfvars" \
    | head -1 | sed -E 's/.*"([^"]+)".*/\1/')

# IVIA OIDC discovery serves
IVIA_URL=$(terraform -chdir="${REPO}/infrastructure/services" output -raw ivia_oidc_issuer_url 2>/dev/null \
    || terraform -chdir="${REPO}/infrastructure/services" output -raw ivia_url 2>/dev/null \
    || true)
[ -n "${IVIA_URL}" ] || { echo "FAIL: cannot resolve IVIA URL from tier-2 outputs"; exit 1; }
DISCOVERY=$(curl -sk "${IVIA_URL%/}/mga/sps/oauth/oauth20/metadata" \
    || curl -sk "${IVIA_URL%/}/.well-known/openid-configuration" \
    || true)
echo "${DISCOVERY}" | jq -e '.issuer and .authorization_endpoint and .token_endpoint' >/dev/null \
    || { echo "FAIL: IVIA OIDC discovery did not return issuer + authorization + token URLs"; exit 1; }
echo "PASS: IVIA OIDC discovery serves"

# banking-ui Ingress ADDRESS populated
ADDR=$(kubectl --context "${CLUSTER}" -n banking-app get ingress banking-ui \
    -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true)
[ -n "${ADDR}" ] || { echo "FAIL: banking-ui Ingress has no ALB address"; exit 1; }
echo "PASS: banking-ui Ingress ADDRESS=${ADDR}"

# Vault jwt auth role uc2-jwt
ROOT_TOKEN=$(jq -r '.root_token' ~/vault-init.json 2>/dev/null) \
    || { echo "FAIL: ~/vault-init.json missing"; exit 1; }
JWT_ROLE=$(kubectl --context "${CLUSTER}" exec -n vault vault-0 -- \
    sh -c "VAULT_TOKEN='${ROOT_TOKEN}' vault read -format=json auth/jwt/role/uc2-jwt" 2>/dev/null) \
    || { echo "FAIL: auth/jwt/role/uc2-jwt missing"; exit 1; }
AUD=$(jq -r '.data.bound_audiences[0]' <<<"${JWT_ROLE}")
[ "${AUD}" = "agent-uc2" ] || { echo "FAIL: bound_audiences[0]=${AUD}, expected agent-uc2"; exit 1; }
echo "PASS: auth/jwt/role/uc2-jwt bound_audiences = [agent-uc2]"

echo "12-uc2-oauth-pkce: all checks green"
