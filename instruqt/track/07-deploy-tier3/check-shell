#!/usr/bin/env bash
#===============================================================================
# 07-deploy-tier3/check-shell
# Asserts tier-3 artifacts:
#   - 5 workshop deploys Ready (uc1-agent, uc2-agent, uc3-agent, banking-app,
#     banking-ui)
#   - OpenLDAP user `jaime` resolvable via ldapsearch (from autoconf seed)
#   - banking RDS transactions table > 0 rows (seed-banking-db.sh ran)
#   - At least one Bedrock KB ingestion job COMPLETE for the HR data source
#===============================================================================

set -euo pipefail

REPO="/root/workshop"
CLUSTER=$(grep -E '^[[:space:]]*cluster_name[[:space:]]*=' "${REPO}/infrastructure/terraform.tfvars" \
    | head -1 | sed -E 's/.*"([^"]+)".*/\1/')

# Workshop deployments
for d in uc1-agent uc2-agent uc3-agent banking-app banking-ui; do
    kubectl --context "${CLUSTER}" -n workshop rollout status "deploy/${d}" --timeout=60s \
        || { echo "FAIL: deploy/${d} not Ready"; exit 1; }
done
echo "PASS: 5 workshop deploys Ready"

# OpenLDAP user jaime resolvable (autoconf seed plus deploy step 12 idempotent verify)
kubectl --context "${CLUSTER}" -n verify-access exec deploy/openldap -- \
    ldapsearch -x -H ldap://localhost -b "dc=ibm,dc=com" -LLL "(uid=jaime)" dn 2>/dev/null \
    | grep -q "uid=jaime" \
    || { echo "FAIL: ldapsearch could not resolve uid=jaime"; exit 1; }
echo "PASS: OpenLDAP user jaime resolvable"

# Bedrock KB ingestion job COMPLETE
cd "${REPO}"
KB_ID=$(terraform -chdir=infrastructure output -raw kb_id 2>/dev/null) \
    || { echo "FAIL: tier-1 output kb_id not readable"; exit 1; }
HR_DS=$(terraform -chdir=infrastructure output -raw kb_hr_data_source_id 2>/dev/null) \
    || { echo "FAIL: tier-1 output kb_hr_data_source_id not readable"; exit 1; }
STATUS=$(aws --region "${AWS_REGION_KB}" bedrock-agent list-ingestion-jobs \
    --knowledge-base-id "${KB_ID}" --data-source-id "${HR_DS}" \
    --query 'ingestionJobSummaries[0].status' --output text 2>/dev/null || true)
[ "${STATUS}" = "COMPLETE" ] \
    || { echo "FAIL: HR ingestion job status=${STATUS}, expected COMPLETE"; exit 1; }
echo "PASS: HR data source ingestion COMPLETE"

echo "07-deploy-tier3: all checks green"
