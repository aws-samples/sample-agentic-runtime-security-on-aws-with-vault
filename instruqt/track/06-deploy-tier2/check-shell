#!/usr/bin/env bash
#===============================================================================
# 06-deploy-tier2/check-shell
# Asserts tier-2 artifacts:
#   - vault-0 reports Sealed=false + Initialized=true
#   - all 7 IVIA pods Ready
#   - autoconf Job Completed
#   - workshop-le-tls Certificate Ready in verify-access namespace
#===============================================================================

set -euo pipefail

REPO="/root/workshop"
# kubectl alias deploy-workshop.sh Step 2 writes (see deploy-workshop.sh:461)
KUBE_CONTEXT="workshop"

# Vault
STATUS=$(kubectl --context "${KUBE_CONTEXT}" exec -n vault vault-0 -- vault status -format=json 2>/dev/null || true)
[ -n "${STATUS}" ] || { echo "FAIL: could not get vault-0 status"; exit 1; }
SEALED=$(jq -r '.sealed' <<<"${STATUS}")
INIT=$(jq -r '.initialized' <<<"${STATUS}")
[ "${SEALED}" = "false" ] || { echo "FAIL: vault-0 sealed=${SEALED}, expected false"; exit 1; }
[ "${INIT}" = "true" ] || { echo "FAIL: vault-0 initialized=${INIT}, expected true"; exit 1; }
echo "PASS: vault-0 Sealed=false, Initialized=true"

# IVIA pods. The verify_access module labels pods with `app=<name>` (see
# infrastructure/modules/verify_access/main.tf:801, 805, 989, etc.), not the
# common `app.kubernetes.io/name=<name>` key — so we select by `app`.
for pod in iviaconfig iviawrprp1 iviaruntime iviaop iviadsc openldap postgresql; do
    READY=$(kubectl --context "${KUBE_CONTEXT}" -n verify-access get pods \
        -l "app=${pod}" \
        -o jsonpath='{.items[0].status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || true)
    if [ "${READY}" != "True" ]; then
        # Fallback: name-prefix match for pods whose chart applied no app label.
        READY=$(kubectl --context "${KUBE_CONTEXT}" -n verify-access get pods --no-headers 2>/dev/null \
            | awk -v p="${pod}" '$1 ~ "^"p {if ($2 ~ /\/[1-9]/ && $3 == "Running") print "True"; exit}')
    fi
    [ "${READY}" = "True" ] || { echo "FAIL: IVIA pod ${pod} not Ready"; exit 1; }
done
echo "PASS: all 7 IVIA pods Ready"

# autoconf Job complete — resource is `kubernetes_job_v1.ivia_autoconf` in
# infrastructure/modules/verify_access/main.tf:1627, metadata.name=ivia-autoconf.
COMP=$(kubectl --context "${KUBE_CONTEXT}" -n verify-access get job ivia-autoconf \
    -o jsonpath='{.status.conditions[?(@.type=="Complete")].status}' 2>/dev/null || true)
[ "${COMP}" = "True" ] || { echo "FAIL: ivia-autoconf Job not Complete"; exit 1; }
echo "PASS: ivia-autoconf Job Complete"

# workshop-le-tls Certificate Ready — Certificate CR lives in the cert-manager
# namespace (see deploy-workshop.sh:852-867), not verify-access.
READY=$(kubectl --context "${KUBE_CONTEXT}" -n cert-manager get certificate workshop-le-tls \
    -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || true)
[ "${READY}" = "True" ] || { echo "FAIL: workshop-le-tls Certificate not Ready"; exit 1; }
echo "PASS: workshop-le-tls Certificate Ready"

echo "06-deploy-tier2: all checks green"
