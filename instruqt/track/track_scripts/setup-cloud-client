#!/usr/bin/env bash
#===============================================================================
# track_scripts/setup-cloud-client — Instruqt track-play bootstrap.
#
# Runs ONCE per track-play (before challenge 01-welcome displays) inside the
# Instruqt sandbox cloud-client container. Responsibilities, in order:
#
#   0. Install the workshop CLI toolchain that cloud-client:2 doesn't ship
#      (terraform, kubectl, helm, ldapsearch, psql, unzip).
#   a. Translate Instruqt's AWS-account env vars into ~/.aws/credentials so
#      the aws CLI and the Terraform AWS provider pick them up with zero
#      AWS_PROFILE export.
#   b. Write the SSH deploy key from runtime parameter INSTRUQT_GITHUB_IBM_DEPLOY_KEY
#      to ~/.ssh/id_ed25519 (mode 0600) and clone the workshop repo over SSH.
#   c. Run check-prerequisites.sh --skip-tools (validates credentials, region,
#      Bedrock model access, quotas, IAM).
#   d. Run bootstrap.sh --skip-prereq-gate (seeds the 3 tfvars from .example,
#      stamps admin_principal_arn from STS, terraform init in all 3 roots).
#
# DEBUG MODE: this version emits structured START/OK markers at every step
# and dumps every INSTRUQT_* env var visible at script start (secrets
# redacted). Use the log output to diagnose where setup stalls or fails.
#===============================================================================

set -euo pipefail

REPO_DIR="/root/workshop"
SSH_KEY_PATH="${HOME}/.ssh/id_ed25519"
KNOWN_HOSTS="${HOME}/.ssh/known_hosts"
GIT_REMOTE="git@github.ibm.com:Oscar-Medina/agentic-runtime-security-aws.git"

# Tool versions pinned for reproducibility. Bump in one place.
TERRAFORM_VERSION="1.10.5"
KUBECTL_VERSION="v1.31.4"
HELM_VERSION="v3.16.4"
VAULT_VERSION="1.21.4"

# Structured step markers — every step prints START at entry and OK at exit.
# A missing OK after a START tells you exactly where the script died.
step_start() { echo "==> step $1 START: $2"; }
step_ok()    { echo "==> step $1 OK"; }
step_fail()  { echo "==> step $1 FAIL: $2" >&2; }

# Redact known-sensitive value patterns from any line. The redaction is
# substring-based (greedy from the `=`), so it catches both raw env-style
# lines and embedded shell expansions. Add patterns here as new sensitive
# vars surface.
redact() {
    sed -E \
        -e 's/(AWS_SECRET_ACCESS_KEY[^=]*=)[^[:space:]]*/\1<REDACTED>/g' \
        -e 's/(PASSWORD[^=]*=)[^[:space:]]*/\1<REDACTED>/g' \
        -e 's/(DEPLOY_KEY[^=]*=)[^[:space:]]*/\1<REDACTED>/g' \
        -e 's/(_SECRET[^=]*=)[^[:space:]]*/\1<REDACTED>/g'
}

#--- preflight env dump --------------------------------------------------------
echo "==============================================================================="
echo "==> [debug] PREFLIGHT context"
echo "    hostname=$(hostname)  uid=$(id -u)  pwd=$(pwd)  date=$(date -u +%FT%TZ)"
echo "    participant=${INSTRUQT_PARTICIPANT_ID:-<unset>}"
echo "    track=${INSTRUQT_TRACK_ID:-<unset>}"
echo "    INSTRUQT_AWS_ACCOUNTS=${INSTRUQT_AWS_ACCOUNTS:-<unset>}"
echo "==> [debug] ALL INSTRUQT_* env vars visible to this lifecycle script (redacted):"
if env | grep -E '^INSTRUQT' >/dev/null 2>&1; then
    env | grep -E '^INSTRUQT' | sort | redact | sed 's/^/    /'
else
    echo "    (none found — Instruqt did not inject any INSTRUQT_* vars)"
fi
echo "==> [debug] \$INSTRUQT_ENV_VARS contents (redacted, AWS-related lines highlighted):"
if [ -n "${INSTRUQT_ENV_VARS:-}" ]; then
    echo "${INSTRUQT_ENV_VARS}" | redact | sed 's/^/    /'
else
    echo "    (INSTRUQT_ENV_VARS is unset or empty)"
fi
echo "==============================================================================="

#--- step (0) ------------------------------------------------------------------
step_start "(0)" "install workshop CLI toolchain on cloud-client:2"
export DEBIAN_FRONTEND=noninteractive

if ! command -v terraform >/dev/null 2>&1; then
    echo "    Installing terraform ${TERRAFORM_VERSION}"
    curl -fsSL "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip" -o /tmp/terraform.zip
    (cd /usr/local/bin && unzip -o /tmp/terraform.zip terraform >/dev/null)
    chmod +x /usr/local/bin/terraform
    rm -f /tmp/terraform.zip
else
    echo "    terraform already present: $(command -v terraform)"
fi

if ! command -v kubectl >/dev/null 2>&1; then
    echo "    Installing kubectl ${KUBECTL_VERSION}"
    curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" -o /usr/local/bin/kubectl
    chmod +x /usr/local/bin/kubectl
else
    echo "    kubectl already present: $(command -v kubectl)"
fi

if ! command -v helm >/dev/null 2>&1; then
    echo "    Installing helm ${HELM_VERSION}"
    curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" -o /tmp/helm.tgz
    tar -xzf /tmp/helm.tgz -C /tmp linux-amd64/helm
    install -m 0755 /tmp/linux-amd64/helm /usr/local/bin/helm
    rm -rf /tmp/helm.tgz /tmp/linux-amd64
else
    echo "    helm already present: $(command -v helm)"
fi

if ! command -v vault >/dev/null 2>&1; then
    echo "    Installing vault ${VAULT_VERSION}"
    curl -fsSL "https://releases.hashicorp.com/vault/${VAULT_VERSION}/vault_${VAULT_VERSION}_linux_amd64.zip" -o /tmp/vault.zip
    (cd /usr/local/bin && unzip -o /tmp/vault.zip vault >/dev/null)
    chmod +x /usr/local/bin/vault
    rm -f /tmp/vault.zip
else
    echo "    vault already present: $(command -v vault)"
fi

# code-server (open-source VS Code Server) — installed once per sandbox.
# Used by the 03-ivia-licensing challenge: attendees obtain their own 90-day
# IVIA trial PEM from https://isva-trial.verify.ibm.com/ and drag-and-drop /
# upload it into the repo via the IDE file explorer. Exposed as a service
# tab on port 8080 (declared in config.yml.tmpl). Sandbox URL is participant-
# scoped (single-attendee pod), so --auth none is safe.
if ! command -v code-server >/dev/null 2>&1; then
    echo "    Installing code-server (via the upstream install.sh)"
    curl -fsSL https://code-server.dev/install.sh | sh >/dev/null
else
    echo "    code-server already present: $(command -v code-server)"
fi

if ! pgrep -f 'code-server.*--port 8080' >/dev/null 2>&1 \
   && ! ss -ltn 2>/dev/null | grep -q ':8080[[:space:]]'; then
    echo "    Launching code-server on :8080 (workspace /root/workshop, auth disabled)"
    # nohup + disown so the server persists past the lifecycle script exit.
    # Logs to /var/log/code-server.log for debugging if a play stalls.
    nohup code-server \
        --bind-addr 0.0.0.0:8080 \
        --auth none \
        /root \
        > /var/log/code-server.log 2>&1 &
    disown $!
    # Wait briefly for the listener to come up so the service tab doesn't
    # 502 on first click. 5s is generous on cloud-client:2.
    for i in 1 2 3 4 5; do
        ss -ltn 2>/dev/null | grep -q ':8080[[:space:]]' && break
        sleep 1
    done
else
    echo "    code-server already listening on :8080"
fi

if ! command -v ldapsearch >/dev/null 2>&1 || ! command -v psql >/dev/null 2>&1 || ! command -v bc >/dev/null 2>&1; then
    echo "    Installing apt packages: ldap-utils postgresql-client unzip bc"
    apt-get update -qq
    apt-get install -y -qq ldap-utils postgresql-client unzip ca-certificates bc >/dev/null
else
    echo "    ldapsearch + psql + bc already present"
fi

echo "    versions:"
echo "      $(terraform version | head -1)"
echo "      $(kubectl version --client=true 2>&1 | head -1)"
echo "      $(helm version --short)"
step_ok "(0)"

#--- step (a) ------------------------------------------------------------------
step_start "(a)" "translate Instruqt AWS env vars → ~/.aws/credentials"

# Empirically discover which AWS-related env vars Instruqt actually injects
# into THIS lifecycle script's environment. The earlier ADMIN_-vs-USER docs
# reading failed empirically, so this dump is the ground truth.
echo "    [debug] env vars matching INSTRUQT_.*AWS (redacted):"
if env | grep -E '^INSTRUQT_.*AWS' >/dev/null 2>&1; then
    env | grep -E '^INSTRUQT_.*AWS' | sort | redact | sed 's/^/      /'
else
    echo "      (none found — Instruqt injected zero INSTRUQT_*AWS* vars into this script)"
fi

# Empirical naming (confirmed by participant sd90gsdib4zw debug dump 2026-06-17):
# Instruqt UPPERCASES the account-name token inside the variable name, even
# when config.yml declares `aws_accounts[0].name: workshop` (lowercase). The
# `_ACCOUNT_NAME` value stays lowercase, but the var-name token is uppercased.
# There is NO `ADMIN_` variant for this account — the plain `_AWS_*` form IS
# injected into the lifecycle script (earlier docs-based guess was wrong).
ACCESS_KEY=""
SECRET_KEY=""
for src in \
    "INSTRUQT_AWS_ACCOUNT_WORKSHOP_AWS_ACCESS_KEY_ID:INSTRUQT_AWS_ACCOUNT_WORKSHOP_AWS_SECRET_ACCESS_KEY" \
    "INSTRUQT_AWS_ACCOUNT_workshop_AWS_ACCESS_KEY_ID:INSTRUQT_AWS_ACCOUNT_workshop_AWS_SECRET_ACCESS_KEY" \
    ; do
    ak="${src%%:*}"
    sk="${src##*:}"
    if [ -n "${!ak:-}" ] && [ -n "${!sk:-}" ]; then
        ACCESS_KEY="${!ak}"
        SECRET_KEY="${!sk}"
        echo "    [debug] using credential pair from: $ak / $sk"
        break
    else
        echo "    [debug] candidate empty: $ak (=${!ak:+<set>}${!ak:-<unset>}) / $sk (=${!sk:+<set>}${!sk:-<unset>})"
    fi
done

if [ -z "${ACCESS_KEY}" ] || [ -z "${SECRET_KEY}" ]; then
    step_fail "(a)" "no usable credential pair found in the lifecycle script environment"
    echo "    Expected one of these pairs to be set:"
    echo "      INSTRUQT_AWS_ACCOUNT_WORKSHOP_AWS_ACCESS_KEY_ID + ..._WORKSHOP_AWS_SECRET_ACCESS_KEY  (uppercase token, current)"
    echo "      INSTRUQT_AWS_ACCOUNT_workshop_AWS_ACCESS_KEY_ID + ..._workshop_AWS_SECRET_ACCESS_KEY  (lowercase fallback)"
    echo "    See the PREFLIGHT dump above for the actual var names Instruqt injected."
    exit 1
fi

mkdir -p "${HOME}/.aws"
cat > "${HOME}/.aws/credentials" <<EOF
[default]
aws_access_key_id     = ${ACCESS_KEY}
aws_secret_access_key = ${SECRET_KEY}
EOF
chmod 600 "${HOME}/.aws/credentials"
echo "    wrote ${HOME}/.aws/credentials ($(wc -c < "${HOME}/.aws/credentials") bytes, mode $(stat -c '%a' "${HOME}/.aws/credentials" 2>/dev/null || stat -f '%Lp' "${HOME}/.aws/credentials"))"
step_ok "(a)"

#--- step (b) ------------------------------------------------------------------
step_start "(b)" "SSH deploy key + repo clone"

echo "    [debug] INSTRUQT_GITHUB_IBM_DEPLOY_KEY set? $([ -n "${INSTRUQT_GITHUB_IBM_DEPLOY_KEY:-}" ] && echo yes || echo NO)"
if [ -z "${INSTRUQT_GITHUB_IBM_DEPLOY_KEY:-}" ]; then
    step_fail "(b)" "runtime parameter INSTRUQT_GITHUB_IBM_DEPLOY_KEY is unset/empty — paste the private key in the invite link Advanced options"
    exit 1
fi

mkdir -p "${HOME}/.ssh"
chmod 700 "${HOME}/.ssh"

# The Instruqt invite-link runtime parameter is a SINGLE-LINE text input.
# A multi-line PEM pasted into it gets flattened: every newline becomes a
# single space. The base64 body lands shaped like
#     -----BEGIN OPENSSH PRIVATE KEY----- b3BlbnNz... -----END OPENSSH PRIVATE KEY-----
# OpenSSH's libcrypto refuses to parse a key whose base64 body has embedded
# whitespace ("Load key ...: error in libcrypto" → Permission denied (publickey)).
# Recover by re-extracting the body, stripping ALL whitespace, fold(1)-wrapping
# to 70-char lines (the convention ssh-keygen emits), then sandwiching back
# between the canonical BEGIN/END banners.
KEY_BODY=$(
    printf '%s' "${INSTRUQT_GITHUB_IBM_DEPLOY_KEY}" \
        | sed -E 's/.*-----BEGIN [A-Z ]+ PRIVATE KEY-----//' \
        | sed -E 's/-----END [A-Z ]+ PRIVATE KEY-----.*//' \
        | tr -d '[:space:]'
)
if [ -z "${KEY_BODY}" ]; then
    step_fail "(b)" "could not extract base64 body between BEGIN/END banners in INSTRUQT_GITHUB_IBM_DEPLOY_KEY"
    exit 1
fi
{
    echo "-----BEGIN OPENSSH PRIVATE KEY-----"
    echo "${KEY_BODY}" | fold -w 70
    echo "-----END OPENSSH PRIVATE KEY-----"
} > "${SSH_KEY_PATH}"
chmod 600 "${SSH_KEY_PATH}"
echo "    wrote ${SSH_KEY_PATH} ($(wc -c < "${SSH_KEY_PATH}") bytes, $(wc -l < "${SSH_KEY_PATH}") lines)"

# Sanity-check the rewrapped key BEFORE attempting clone — `ssh-keygen -y`
# only succeeds if libcrypto can parse the private half (it derives + prints
# the public half). Fails fast with a clear message instead of leaving us to
# diagnose "Permission denied (publickey)" inside git.
if ssh-keygen -y -f "${SSH_KEY_PATH}" >/dev/null 2>&1; then
    echo "    ssh-keygen -y validates rewrapped key — proceeding to clone"
else
    step_fail "(b)" "rewrapped private key failed ssh-keygen -y validation — base64 body recovered from env var is invalid"
    exit 1
fi

# ssh-keyscan WITHOUT a `-t` filter so we accept all supported host key types
# (rsa/ecdsa/ed25519). The prior `-t ed25519` filter returned nothing because
# github.ibm.com does not offer an ed25519 host key — git then negotiated the
# server's actual key type, found no matching trusted entry, and reported
# "Host key verification failed". Drop the filter, capture both streams so
# diagnostics surface, and append only well-formed host-key lines.
KEYSCAN_OUT=$(ssh-keyscan -T 10 github.ibm.com 2>&1) || true
echo "    [ssh-keyscan output]"
echo "${KEYSCAN_OUT}" | sed 's/^/      /'
echo "${KEYSCAN_OUT}" | grep '^github\.ibm\.com ' >> "${KNOWN_HOSTS}" || true
chmod 644 "${KNOWN_HOSTS}"

if ! grep -q '^github\.ibm\.com ' "${KNOWN_HOSTS}"; then
    step_fail "(b)" "ssh-keyscan produced no usable host-key line for github.ibm.com — git clone will fail with Host key verification failed"
    exit 1
fi
echo "    known_hosts entries for github.ibm.com:"
grep '^github\.ibm\.com ' "${KNOWN_HOSTS}" | awk '{print "      " $1, $2}'

if [ -d "${REPO_DIR}/.git" ]; then
    echo "    repo already cloned at ${REPO_DIR} — running git fetch + reset to origin/main (idempotent)"
    git -C "${REPO_DIR}" fetch origin
    git -C "${REPO_DIR}" reset --hard origin/main
else
    echo "    cloning ${GIT_REMOTE} → ${REPO_DIR}"
    git clone "${GIT_REMOTE}" "${REPO_DIR}"
fi
echo "    HEAD: $(git -C "${REPO_DIR}" log --oneline -1)"
step_ok "(b)"

#--- region resolution ---------------------------------------------------------
step_start "(region)" "resolve primary + KB region from canonical SoT"

TFVARS_EXAMPLE="${REPO_DIR}/infrastructure/terraform.tfvars.example"
if [ ! -f "${TFVARS_EXAMPLE}" ]; then
    step_fail "(region)" "${TFVARS_EXAMPLE} missing after clone — repo structure changed?"
    exit 1
fi
PRIMARY_REGION=$(grep -E '^[[:space:]]*region[[:space:]]*=' "${TFVARS_EXAMPLE}" \
    | head -1 | sed -E 's/.*"([^"]+)".*/\1/')
KB_REGION=$(grep -E '^[[:space:]]*kb_region[[:space:]]*=' "${TFVARS_EXAMPLE}" \
    | head -1 | sed -E 's/.*"([^"]+)".*/\1/')
if [ -z "${PRIMARY_REGION}" ] || [ -z "${KB_REGION}" ]; then
    step_fail "(region)" "could not parse region/kb_region from ${TFVARS_EXAMPLE} (PRIMARY=${PRIMARY_REGION:-<empty>}, KB=${KB_REGION:-<empty>})"
    exit 1
fi

mkdir -p /etc/profile.d
# AWS_PAGER="": cloud-client:2 doesn't ship `less`; AWS CLI v2's default pager
#   pipe fails with `[Errno 2] No such file or directory: 'less'`. Disabling
#   the pager unconditionally avoids the failure for every aws CLI call.
# CHECKPOINT_DISABLE=1: silences Terraform's "you're out of date" banner —
#   we pin 1.10.5 deliberately for Stacks compatibility, the upgrade prompt
#   is noise.
cat > /etc/profile.d/aws.sh <<EOF
export AWS_REGION="${PRIMARY_REGION}"
export AWS_DEFAULT_REGION="${PRIMARY_REGION}"
export AWS_REGION_KB="${KB_REGION}"
export AWS_PAGER=""
export CHECKPOINT_DISABLE=1
EOF
chmod 644 /etc/profile.d/aws.sh

# /etc/profile.d/aws.sh is sourced ONLY by login shells (via /etc/profile).
# Instruqt's terminal tab opens an interactive NON-login shell — bash sources
# /etc/bash.bashrc for those, not /etc/profile.d/*.sh. Without this hook the
# attendee's shell never sees AWS_PAGER="" and `aws sts get-caller-identity`
# fails with `[Errno 2] No such file or directory: 'less'` (cloud-client:2
# doesn't ship less). Idempotent — grep guard prevents duplicate appends on
# re-runs.
if ! grep -qF 'source /etc/profile.d/aws.sh' /etc/bash.bashrc 2>/dev/null; then
    printf '\n# Added by Instruqt setup-cloud-client — see /etc/profile.d/aws.sh\nsource /etc/profile.d/aws.sh\n' >> /etc/bash.bashrc
    echo "    appended source-line to /etc/bash.bashrc (interactive non-login shells)"
else
    echo "    /etc/bash.bashrc already sources /etc/profile.d/aws.sh"
fi

export AWS_REGION="${PRIMARY_REGION}"
export AWS_DEFAULT_REGION="${PRIMARY_REGION}"
export AWS_REGION_KB="${KB_REGION}"
export AWS_PAGER=""
export CHECKPOINT_DISABLE=1
echo "    primary=${AWS_REGION}  kb=${AWS_REGION_KB}"
step_ok "(region)"

#--- sts probe -----------------------------------------------------------------
step_start "(sts)" "aws sts get-caller-identity (proves creds are usable)"
if ! aws sts get-caller-identity --query Account --output text; then
    step_fail "(sts)" "aws sts get-caller-identity failed — creds in ~/.aws/credentials are not usable"
    exit 1
fi
step_ok "(sts)"

#--- step (c) ------------------------------------------------------------------
# Instruqt-sandbox-specific skips:
#   --skip-quotas:  servicequotas API is SCP-blocked (servicequotas not on
#                   Instruqt's 43-key allowed-services list).
#   --skip-iam-sim: iam:SimulatePrincipalPolicy returns implicitDeny under
#                   Instruqt's SCP architecture for actions the principal
#                   can actually perform; terraform apply is ground truth.
step_start "(c)" "check-prerequisites.sh --skip-tools --skip-quotas --skip-iam-sim"
bash "${REPO_DIR}/infrastructure/scripts/check-prerequisites.sh" \
    --skip-tools --skip-quotas --skip-iam-sim
step_ok "(c)"

#--- step (d) ------------------------------------------------------------------
step_start "(d)" "bootstrap.sh --skip-prereq-gate"
bash "${REPO_DIR}/infrastructure/scripts/bootstrap.sh" --skip-prereq-gate
step_ok "(d)"

echo "==> setup-cloud-client COMPLETE — challenge 01-welcome ready to display"
