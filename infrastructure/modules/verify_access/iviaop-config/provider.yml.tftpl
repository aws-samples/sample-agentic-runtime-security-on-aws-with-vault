# Copyright contributors to the IBM Security Verify Access OIDC Provider Resources project
version: 23.03
logging:
  level: trace
server:
  ssl:
    key: 'ks:isvaop_keys/httpserverkey'
    certificate: 'ks:isvaop_keys/httpservercert'
  pages:
    type: zip                       
    content: "@templates.zip" 
# Mandatory when grant_types includes authorization_code or implicit (IBM
# provider.yml schema). Without it the /oauth2/auth endpoint is a no-op
# redirect and no authentication session is established. ISVAOP relies on the
# WRP as point-of-contact: the browser is sent to ${ivia_public_url}/oauth2/auth
# (an anyauth-protected junction path) where WebSEAL injects the iv-jwt
# credential, then ISVAOP establishes the session and returns to callback_param.
authentication:
  endpoint: ${ivia_public_url}/oauth2/auth
  callback_param_name: Target
  # subject_attribute_name names the JWT claim/credential attribute that
  # populates the OIDC `sub`. Default is `uid`, but the WebSEAL jwt:/isvaop
  # stanza emits the principal as claim `sub` — so without this the provider
  # finds no subject and /oauth2/auth never establishes a session.
  subject_attribute_name: sub
definition:
  id: 1
  name: OIDC Definition
  grant_types:
    - authorization_code
    - client_credentials
    - refresh_token
    - urn:openid:params:grant-type:ciba
    - urn:ietf:params:oauth:grant-type:token-exchange
  access_policy_id: isvaop_policy
  # Runs before each access token is minted. Used by UC3 to inject the may_act
  # delegation claim onto the RFC 8693 token-exchange output token (gated on
  # grant_type so other grants are untouched). See rules.yaml isvaop_pretoken.
  pre_mappingrule_id: isvaop_pretoken
  base_url: ${ivia_public_url}
  token_settings:
    issuer: ${ivia_public_issuer}
    signing_alg: RS256
    signing_keystore: isvaop_keys
    signing_keylabel: httpserverkey
    # Issue access tokens as signed RS256 JWTs (typ: at+jwt) rather than opaque
    # reference tokens. REQUIRED for UC3: Vault's jwt auth backend validates the
    # token-exchange output against the iviaop JWKS, which only works for a JWT.
    access_token_type: jwt
  features:
    consent_prompt: ALWAYS_PROMPT
    enable_dynamic_registration: true
  backchannel_settings:
    default_expiry: 900
    maximum_expiry: 1800
    polling_interval: 5
    notifyuser_mappingrule_id: notifyuser
    checkstatus_mappingrule_id: checkstatus
    # Allows the uc3-agent to include a user_code on bc-authorize; it surfaces in
    # the notifyuser rule and the binding context. Consent itself is served by the
    # InternalAuthenticator at /isvaop/oauth2/ciba_user_authorize/{transactionID}
    # (NOT the device-flow /oauth2/user_authorization endpoint). Pairs with the
    # client backchannel_user_code_parameter.
    user_code_support: true
  # Rich Authorization Requests (RAR) — UC3 privileged refund flow + Vault-native
  # per-request scope. Registers the custom authorization_details types emitted on
  # the token-exchange output (isvaop_pretoken); without provider registration
  # IVIAOP rejects with "Unknown authorization detail type <type>".
  #   - refund_approval : business RAR (audit correlation); sent on CIBA bc-authorize.
  #   - vault:path_access : Vault-native RAR the isvaop_pretoken rule stamps on the
  #     UC3 delegated token (path + capabilities) so Vault narrows the token to the
  #     exact path/capabilities per request.
  # strategy sha512 hashes the entire payload (no assumption about which fields exist).
  authorization_details_types_supported:
    - type: refund_approval
      strategy: sha512
    - type: vault:path_access
      strategy: sha512
jwks:
  signing_keystore: isvaop_keys

keystore:
  - name: isvaop_keys
    type: pem
    certificate:
      - label: httpservercert
        content: '@iviaop.pem'

      - label: postgres
        content: '@postgres.crt'
    key:
      - label: httpserverkey
        content: '@iviaop.key'
