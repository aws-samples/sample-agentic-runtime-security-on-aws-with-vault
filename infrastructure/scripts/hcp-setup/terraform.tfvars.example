################################################################################
# HCP Terraform setup — example tfvars
#
# This file is a TEMPLATE. The real `terraform.tfvars` is generated by
# infrastructure/scripts/bootstrap.sh from the calling environment and is
# .gitignore'd. Copy this file only if you want to run hcp-setup manually
# without bootstrap.sh.
#
#   cp terraform.tfvars.example terraform.tfvars
#   # then edit each value below
#   terraform init && terraform apply
################################################################################

# Your HCP Terraform organization name (https://app.terraform.io/app/settings/general)
hcp_org             = "your-hcp-org-name"

# Your AWS account ID (12 digits)
aws_account_id      = "123456789012"

# AWS region — workshop is locked to us-west-2 per CONTEXT.md
aws_region          = "us-west-2"

# IAM role ARN HCP Stacks assumes via OIDC.
# Created by bootstrap.sh Step 2; matches the role's name in that script.
iam_role_arn        = "arn:aws:iam::123456789012:role/hcp-stacks-deploy"

# Workshop attendee's IAM principal ARN — granted cluster-admin on EKS via
# access entry. Get yours: aws sts get-caller-identity --query Arn --output text
# (If the result is an arn:aws:sts::*:assumed-role/* form, rewrite it to
#  arn:aws:iam::ACCOUNT:role/ROLE — the EKS access entry API requires the
#  underlying IAM role ARN.)
admin_principal_arn = "arn:aws:iam::123456789012:role/your-admin-role"

# Optional overrides — defaults below are the workshop-locked values; change
# only if your org already has a project/varset by these names that conflicts.
project_name        = "Agentic Runtime Security"
varset_name         = "agentic-runtime-stacks-config"
