################################################################################
# Tier-3 (workloads) — Variable Values (EXAMPLE)
#
# USAGE: cp terraform.tfvars.example terraform.tfvars  (terraform.tfvars is gitignored)
#
# This root (infrastructure/workloads/) deploys the end-user apps: uc1 agent,
# uc2 banking (UI + agent + MCP), uc3 agent, plus the iviaop agent-uc2
# redirect_uri patch. region / cluster / RDS / KB / ACM cert come from tier-1
# state; Vault + IVIA wiring comes from tier-2 state.
#
# --------------------------------------------------------------------------
# DEFAULT MODE: ecr — build the five images locally and push to your account's
#                     private ECR (requires Docker/Podman + AWS creds)
# --------------------------------------------------------------------------
# bootstrap.sh stamps <account>.dkr.ecr.<region>.amazonaws.com URIs into the
# five image vars below. module.ecr provisions the ECR repos in tier-1.
# deploy-workshop.sh builds and pushes the images before the tier-3 apply.
# This is the default — no need to set image_source unless you opt out to ghcr.
#
# --------------------------------------------------------------------------
# OPT-OUT: --image-source ghcr (no build, no ECR, no container runtime — BYO images)
# --------------------------------------------------------------------------
# Set image_source = "ghcr" to pull pre-built public images instead of building.
# There is NO default GHCR namespace — bring your own: publish the five workshop
# images to your own GHCR (see the repo README: "Optional: pre-built images from
# GHCR (bring your own)"), then set ghcr_registry_base below.
# The five image URIs are derived from ghcr_registry_base in locals — you do NOT
# set the ECR image vars below (they stay "" and are ignored in ghcr mode).
# bootstrap.sh does NOT stamp image lines in ghcr mode.
# deploy-workshop.sh skips the build step in ghcr mode.
################################################################################

# Image source mode (default: ecr — local build → private ECR).
# Uncomment and set to "ghcr" for the no-build bring-your-own-images opt-out.
# image_source = "ghcr"

# GHCR registry base (ghcr mode only). No default — required when image_source = "ghcr".
# Set to the namespace you published to via publish-images.sh --registry-base.
# ghcr_registry_base = "ghcr.io/<githubusername>"

# ECR image URI overrides (ecr mode only).
# In ghcr mode leave these commented — bootstrap does not stamp them and
# the GHCR URIs derived from ghcr_registry_base take effect.
# In ecr mode bootstrap.sh stamps these lines with your account/region values.
#
# uc1_agent_image         = "<account>.dkr.ecr.<region>.amazonaws.com/workshop/uc1-agent:latest"
# banking_app_ui_image    = "<account>.dkr.ecr.<region>.amazonaws.com/workshop-banking-app:ui"
# banking_app_agent_image = "<account>.dkr.ecr.<region>.amazonaws.com/workshop-banking-app:agent"
# banking_app_mcp_image   = "<account>.dkr.ecr.<region>.amazonaws.com/workshop-banking-app:mcp"
# uc3_agent_image         = "<account>.dkr.ecr.<region>.amazonaws.com/workshop/uc3-agent:latest"

# Bedrock LLM — cross-region inference profile id for Amazon Nova Pro.
bedrock_model_id = "us.amazon.nova-pro-v1:0"
