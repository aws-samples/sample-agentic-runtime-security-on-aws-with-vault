#!/usr/bin/env bash
#===============================================================================
# infrastructure/git-hooks/post-merge — auto-push Instruqt track on main merges.
#
# Fires after `git pull` / `gh pr merge` / any other merge into HEAD. When the
# merge that just landed touched anything under `instruqt/`, this hook runs
# `bash instruqt/scripts/push.sh` so the Instruqt platform's copy of the track
# stays in lockstep with main.
#
# Why a local hook (not CI):
#   github.ibm.com org has GitHub Actions disabled. The native Instruqt GitHub
#   App only integrates with github.com, requires an empty repo at connection
#   time, and is not documented for GHE — so neither CI nor native version-
#   control is available. The merge-and-cleanup happens locally on the
#   maintainer's machine; piggybacking on that is the lowest-friction path.
#
# Activation guard:
#   1. Hook ONLY fires when HEAD is on `main`. Feature-branch merges (rebases,
#      catch-ups) are a no-op so we don't accidentally push WIP to Instruqt.
#   2. Hook ONLY fires when the merge actually touched `instruqt/**`. Skips
#      non-Instruqt merges silently.
#
# Failure handling:
#   `instruqt track push` errors propagate (the hook does NOT swallow them) so
#   the maintainer notices immediately if the rendered config is invalid or
#   the Instruqt token has expired.
#===============================================================================
set -euo pipefail

# 1) Only act on main.
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "${current_branch}" != "main" ]; then
    exit 0
fi

# 2) Only act if instruqt/ changed in the merge. ORIG_HEAD = pre-merge HEAD,
# HEAD = post-merge HEAD. `diff --name-only` lists the merge's net file
# changes; grep -q `^instruqt/` short-circuits.
if ! git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -q '^instruqt/'; then
    exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
push_script="${repo_root}/instruqt/scripts/push.sh"
if [ ! -x "${push_script}" ]; then
    echo "post-merge: ${push_script} missing or not executable — skipping Instruqt sync" >&2
    exit 0
fi

echo "post-merge: instruqt/ changed on main — running instruqt/scripts/push.sh"
bash "${push_script}"
