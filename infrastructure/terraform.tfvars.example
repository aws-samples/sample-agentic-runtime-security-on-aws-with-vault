################################################################################
# Tier-1 (core infrastructure) — Variable Values (EXAMPLE)
# Agentic Runtime Security Workshop
#
# USAGE: Copy this file to terraform.tfvars and fill in your values.
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored (contains account-specific values).
# This .example file is the committed reference. bootstrap.sh copies it to
# terraform.tfvars as the starting point.
#
# 3-TIER SPLIT (provisioning-order refactor)
# This root (infrastructure/) provisions core infra ONLY — VPC, EKS, addons,
# RDS, Bedrock KB, ECR, IAM (incl. Vault IAM/KMS), ACM bootstrap cert, EDR,
# observability. The Vault server + IVIA (tier 2) and the end-user apps (tier 3)
# are separate roots with their own terraform.tfvars:
#   - infrastructure/services/terraform.tfvars  (icr_entitlement_key, ivia_mmfa_push_client_secret)
#   - infrastructure/workloads/terraform.tfvars (image URIs, bedrock_model_id)
#
# CANONICAL REGION CONTRACT
# The string literals "us-west-2" and "us-east-1" appear ONLY in this file.
# Every module receives var.region / var.kb_region — no literals in .tf files.
################################################################################

# Canonical region — every module receives this via var.region.
region = "us-west-2"

cluster_name = "ars-workshop"
vpc_cidr     = "10.1.0.0/16"
azs          = ["us-west-2a", "us-west-2b", "us-west-2c"]

# Bedrock KB region — Nova 2 Multimodal Embeddings is us-east-1 only.
kb_region = "us-east-1"

# Let's Encrypt account contact email for the cert-manager ClusterIssuer.
# REQUIRED — the variable has NO default (project rule: never hardcode an
# identity value as a default). LE uses this for renewal/revocation notices.
acme_email = "you@example.com"

# Audit retention (workshop ephemeral; 7-day default)
audit_retention_days = 7

# RDS sizing (db.t3.medium for ≤15 attendees per CONTEXT)
rds_instance_class = "db.t3.medium"

# Admin kubectl access — set to the IAM user/role ARN for the attendee account.
# bootstrap.sh auto-resolves this from `aws sts get-caller-identity`.
admin_principal_arn = "arn:aws:iam::<account-id>:role/<your-role>"

tags = {
  Environment = "workshop"
  Workshop    = "agentic-runtime-security"
  Region      = "us-west-2"
  ManagedBy   = "terraform"
}

# EDR (Uptycs KSPM) — deploy k8sosquery DaemonSet + kubequery Deployment for
# HC-COMPUTE-011 compliance. Values files in modules/edr/values/ are tenant-specific.
enable_edr = true
